# MacOS DS_Store files
.DS_Store

# Gradle cache folder
.gradle

# Gradle build folder
build
!docs/build/

# IntelliJ
out/
.idea
*.iml
# mpeltonen/sbt-idea plugin
.idea_modules/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Common working directory
run

# Kotlin daemon cache
.kotlin/

# Fabric/Stonecutter per-version build outputs
versions/**/.fabric/
versions/**/logs/

# Git worktrees
.worktrees/
/net/
/dev/
/.env
/versions/**/saves/
/versions/**/data/
/versions/**/downloads/
/versions/**/logs/
/versions/**/mods/
/versions/**/resourcepacks/
/versions/**/run/
/versions/**/config/
/versions/**/build/
/versions/**/usercache.json
/versions/**/options.txt
/.claude/settings.local.json
/.claude/scheduled_tasks.lock

# qmd docs search — local index artifacts. The collection config .qmd/index.yml IS committed;
# everything else here is a machine-local build artifact, rebuildable with `qmd update && qmd embed`.
/.qmd/*.sqlite
/.qmd/*.sqlite-*
/.qmd/*.db
/.qmd/*.db-*
/.qmd/*.lock
/.qmd/reindex.log
