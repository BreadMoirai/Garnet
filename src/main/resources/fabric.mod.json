{
  "schemaVersion": 1,
  "id": "garnet",
  "version": "${version}",
  "name": "Garnet",
  "description": "Garnet — a Minecraft redstone spec IDE",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/garnet/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.breadmoirai.garnet.Garnet"
    ],
    "client": [
      "com.breadmoirai.garnet.GarnetClient"
    ],
    "modmenu": [
      "com.breadmoirai.garnet.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "garnet.mixins.json",
    {
      "config": "garnet.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "classTweaker": "garnet.classtweaker"
}
